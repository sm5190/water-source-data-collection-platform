DATABASE_URL=postgresql+psycopg://water:water@localhost:5432/water_source

# --- LLM provider ----------------------------------------------------------------------
# Every LLM call (extraction, procedure distillation, procedure embeddings) goes through
# llm/router.py and uses exactly ONE provider. There is no automatic fallback between them.
#   vt     = Virginia Tech ARC LLM API (default, free; needs the VT Campus VPN)
#   openai = paid OpenAI API; switch by setting LLM_PROVIDER=openai + OPENAI_API_KEY
LLM_PROVIDER=vt

# VT ARC LLM API (https://www.docs.arc.vt.edu/ai/011_llm_api_arc_vt_edu.html). Personal key from
# https://llm.arc.vt.edu -> Settings -> Account -> API keys (never share it).
VT_LLM_BASE_URL=https://llm-api.arc.vt.edu/api/v1
VT_LLM_API_KEY=
VT_LLM_MODEL=gpt-oss-120b
VT_LLM_EMBEDDING_MODEL=Qwen3-Embedding-4B

# OpenAI: unused (and may stay empty) while LLM_PROVIDER=vt.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra

# LLM call policy. Any LLMSettings field (llm/config.py) can be set as LLM__<FIELD>.
# Limits are per worker PROCESS: with N worker processes on one VT key, divide them by N.
# VT allows 20 requests in flight per user across all models.
LLM__REQUESTS_PER_MINUTE=27
LLM__MAX_CONCURRENCY=8
LLM__TIMEOUT_SECONDS=120
LLM__MAX_RETRIES=3                 # 429/timeout/network/5xx only; auth/400/413 never retried
LLM__MAX_OUTPUT_TOKENS=4000        # VT rejects > 8000 on non-streaming requests
LLM__STRUCTURED_MAX_ATTEMPTS=2     # repair round-trips for output that fails the schema
LLM__CACHE_TTL_SECONDS=86400       # in-process response cache; 0 disables
# json_schema | json_object | prompt -- run scripts/llm_smoke.py to see which VT accepts.
LLM__VT_STRUCTURED_MODE=json_schema

# --- Discovery providers ---------------------------------------------------------------
# SearXNG (self-hosted; `docker compose --profile discovery up -d searxng`). Empty = disabled.
SEARXNG_URL=http://localhost:8080
# Secret for the local SearXNG container (any long random string).
SEARXNG_SECRET=
# OpenAlex API key (free: https://openalex.org/settings/api). Empty = keyless, lower limits.
OPENALEX_API_KEY=
# Semantic Scholar API key (optional: https://www.semanticscholar.org/product/api#api-key-form).
SEMANTIC_SCHOLAR_API_KEY=
# Contact email for Crossref's "polite" pool. Not a key; Crossref never emails results.
CROSSREF_MAILTO=

# Discovery policy. Any DiscoverySettings field can be set as DISCOVERY__<FIELD>.
DISCOVERY__ENABLED=true
# JSON list; drop a provider to disable it.
DISCOVERY__PROVIDERS=["searxng","openalex","semantic_scholar","crossref"]
DISCOVERY__TIMEOUT_SECONDS=20
DISCOVERY__MAX_RETRIES=3
DISCOVERY__CACHE_TTL_SECONDS=86400
DISCOVERY__RESULTS_PER_QUERY=10
DISCOVERY__MAX_QUERIES_PER_ROUND=6
DISCOVERY__CROSSREF_VERIFY_TOP_N=15
# DISCOVERY__SEMANTIC_SCHOLAR_RELATED_PER_ROUND=0   # >0 enables related-paper expansion
# DISCOVERY__SEMANTIC_SCHOLAR_LIMITS__MIN_INTERVAL_SECONDS=1.05

# Document acquisition (safe direct HTTP + PDF text). Any AcquisitionSettings field:
# ACQUISITION__<FIELD>, e.g. per-round/per-run document caps and politeness.
# ACQUISITION__MAX_DOCUMENTS_PER_ROUND=6
# ACQUISITION__MAX_DOCUMENTS_TOTAL=18
# ACQUISITION__PER_HOST_MIN_INTERVAL_SECONDS=1.0
# Raw downloaded documents (MinIO from docker-compose; content-addressed by SHA-256).
ARTIFACTS__ENDPOINT=localhost:9000
ARTIFACTS__ACCESS_KEY=minioadmin
ARTIFACTS__SECRET_KEY=minioadmin
ARTIFACTS__BUCKET=source-documents

FIRECRAWL_API_KEY=
APIFY_API_TOKEN=

OTEL_SERVICE_NAME=water-source-research
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

MAX_OPENAI_INPUT_TOKENS_PER_CITY=300000
MAX_OPENAI_OUTPUT_TOKENS_PER_CITY=40000
MAX_FIRECRAWL_CREDITS_PER_CITY=100
MAX_DISCOVERY_ROUNDS_PER_CITY=3

# Procedural memory (advisory planning guidance learned from validated runs).
# Any ProcedureMemorySettings field can be set as PROCEDURE_MEMORY__<FIELD>.
PROCEDURE_MEMORY__ENABLED=false
PROCEDURE_MEMORY__REQUIRE_HUMAN_APPROVAL=true
# llm (default; runs on LLM_PROVIDER, falls back to deterministic without its credentials)
PROCEDURE_MEMORY__DISTILLER=llm
# PROCEDURE_MEMORY__DISTILLER_MODEL=   # defaults to the active provider's model
# PROCEDURE_MEMORY__EMBEDDING_MODEL=text-embedding-3-small   # OpenAI only; VT uses VT_LLM_EMBEDDING_MODEL

# City-run queue (Postgres-backed). Any ResearchQueueSettings field: RESEARCH_QUEUE__<FIELD>.
RESEARCH_QUEUE__WORKER_CONCURRENCY=4
RESEARCH_QUEUE__MAX_ATTEMPTS=3
RESEARCH_QUEUE__LEASE_SECONDS=300
